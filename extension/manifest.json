{
  "manifest_version": 3,
  "name": "CP Assistant",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "description": "Public Codeforces profile analytics, focused practice, and your private notebook.",
  "action": {
    "default_title": "CP Assistant",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/profile/*"
      ],
      "js": ["content/codeforces-profile.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
