{
  "manifest_version": 3,
  "name": "CP Assistant",
  "version": "0.1.0",
  "description": "A focused companion for competitive programming practice.",
  "action": {
    "default_title": "CP Assistant",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/problemset/problem/*",
        "*://www.codeforces.com/problemset/problem/*"
      ],
      "js": ["content/codeforces-problem.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
