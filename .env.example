# Local development. Copy to .env; never commit the real file.
# Generate a random value privately, e.g. Python secrets.token_urlsafe(64).
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
# SQLite is the documented local setup; this selector does not transfer existing data.
DB_ENGINE=sqlite
# Used only when DB_ENGINE=postgresql (production always uses PostgreSQL).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Optional AI features; leave blank to avoid live inference.
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL_NAME=openai/gpt-oss-120b
# Public extension IDs, 32 letters a-p; copy from chrome://extensions.
EXTENSION_ALLOWED_IDS=
EXTENSION_ALLOWED_ORIGIN=
# Production: use .env.production.example and config.production instead.
